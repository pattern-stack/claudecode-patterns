{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "instructions.schema.json",
  "title": "Plan artifact instructions",
  "description": "Tunable knobs for the plan canvas (planner producer; /sync-issues + agent consumers).",
  "type": "object",
  "required": ["artifact", "version", "plan", "issue", "sizing", "layer", "dependencies", "markers"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "artifact": { "const": "plan" },
    "version": { "type": "integer", "minimum": 1 },

    "plan": {
      "type": "object",
      "required": ["required_fields", "optional_fields", "epic_body_max_chars", "epic_body_verbosity"],
      "additionalProperties": false,
      "properties": {
        "required_fields": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "optional_fields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "epic_body_max_chars": {
          "type": "integer",
          "minimum": 100,
          "maximum": 65536
        },
        "epic_body_verbosity": {
          "type": "string",
          "enum": ["short", "medium", "long"]
        },
        "auto_approve_default": {
          "type": "boolean",
          "description": "Default value for plan.auto_approve when omitted in a plan instance. /sync-issues uses this to decide whether to stamp gate:auto / gate:human at issue-creation time."
        }
      }
    },

    "issue": {
      "type": "object",
      "required": ["required_fields", "optional_fields", "description_verbosity", "description_max_lines", "include_acceptance"],
      "additionalProperties": false,
      "properties": {
        "required_fields": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "optional_fields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "description_verbosity": {
          "type": "string",
          "enum": ["short", "medium", "long"]
        },
        "description_max_lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "include_acceptance": {
          "type": "boolean"
        }
      }
    },

    "sizing": {
      "type": "object",
      "required": ["max_issues_per_stack", "min_issues_per_stack", "max_critical_path_depth"],
      "additionalProperties": false,
      "properties": {
        "max_issues_per_stack": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "min_issues_per_stack": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "max_critical_path_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },

    "layer": {
      "type": "object",
      "required": ["enum", "default"],
      "additionalProperties": false,
      "properties": {
        "enum": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "default": {
          "type": ["string", "null"]
        }
      }
    },

    "dependencies": {
      "type": "object",
      "required": ["cycle_detection"],
      "additionalProperties": false,
      "properties": {
        "cycle_detection": { "type": "boolean" },
        "cross_stack_via": {
          "type": "string",
          "enum": ["depends_on_slug", "none"]
        }
      }
    },

    "markers": {
      "type": "object",
      "required": ["epic", "leaf"],
      "additionalProperties": false,
      "properties": {
        "epic": {
          "type": "string",
          "pattern": "^\\[plan-epic:.*\\]$"
        },
        "leaf": {
          "type": "string",
          "pattern": "^\\[plan-key:.*\\]$"
        }
      }
    }
  }
}
