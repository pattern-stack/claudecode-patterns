{
  "description": "Emit Claude Code lifecycle events to the AP dashboard (defaults to http://localhost:3456; override via AP_DASHBOARD_URL).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/emit.mjs SessionStart",
            "async": true,
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p ${CLAUDE_PROJECT_DIR}/.claude/.session && bash ${CLAUDE_PLUGIN_ROOT}/primitives/task-management/discover.sh > ${CLAUDE_PROJECT_DIR}/.claude/.session/tracker-context.md 2>/dev/null || true",
            "async": false,
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/ensure-playground.sh",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "InstructionsLoaded": [
