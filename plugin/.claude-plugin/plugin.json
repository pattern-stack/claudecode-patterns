{
  "name": "sdlc",
  "version": "0.2.16",
  "description": "Plan-first, gate-disciplined SDLC for Claude Code teams. Agents, canvases, primitives, commands.",
  "author": {
    "name": "pattern-stack"
  },
  "homepage": "https://github.com/pattern-stack/claudecode-patterns",
  "license": "MIT",
  "components": {
    "skills": "skills/",
    "agents": "agents/",
    "commands": "commands/",
    "outputStyles": "output-styles/",
    "mcpServers": {
      "chrome-devtools": {
        "type": "stdio",
        "command": "npx",
        "args": ["-y", "chrome-devtools-mcp@1.1.1", "--browserUrl", "http://127.0.0.1:9222"]
      },
      "playwright": {
        "type": "stdio",
        "command": "npx",
        "args": ["-y", "@playwright/mcp@0.0.75", "--headless", "--isolated"]
      },
      "lighthouse": {
        "type": "stdio",
        "command": "npx",
        "args": ["-y", "@danielsogl/lighthouse-mcp@1.3.0"]
      }
    }
  }
}
