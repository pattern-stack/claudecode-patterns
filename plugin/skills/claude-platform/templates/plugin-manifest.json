{
  "name": "my-plugin",
  "version": "0.1.0",
  "description": "What this plugin does",
  "author": "Your Name <you@example.com>",
  "homepage": "https://github.com/you/my-plugin",
  "license": "MIT",

  "components": {
    "skills": "skills/",
    "commands": "commands/",
    "agents": "agents/",
    "outputStyles": "output-styles/",
    "hooks": {
      "SessionStart": [
        {
          "matcher": "",
          "hooks": [
            {
              "type": "command",
              "command": "${CLAUDE_PLUGIN_ROOT}/hooks/on-session-start.sh"
            }
          ]
        }
      ]
    },
    "mcpServers": {
      "my-server": {
        "type": "stdio",
        "command": "npx",
        "args": ["-y", "@example/my-mcp-server"]
      }
    }
  }
}
