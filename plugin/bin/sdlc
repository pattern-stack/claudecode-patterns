#!/usr/bin/env python3
"""sdlc: command line for the sdlc plugin.

    sdlc machines [--registry PATH] [list [--registry PATH]]
    sdlc machines [--registry PATH] [--config FILE] check [--registry PATH] [--config FILE] [--probe] [--timeout SECS]
    sdlc machines [--registry PATH] [--config FILE] where ROLE [--kind phase|agent] [--registry PATH] [--config FILE]

`where ROLE` answers "where does ROLE run?" from the repo's .claude/sdlc.yml and the registry; its
first line is the answer. `check` also checks the repo's placement once the registry is usable.

Exit codes: 0 ok or inert (no registry), 1 an error was found (check) or list had nothing to
show, 2 usage error. `where` exits 0 when the role is placed, or when machines are off because
there is no registry or the repo places nothing; 1 for a fallback, nowhere to run, or machines
off because of an error (a broken registry or sdlc.yml); 2 for usage (including `--config ""`).

Reserved for a later release, not built here: `sdlc delegate <role> ...` (#139).

Claude Code puts a plugin's bin/ on the PATH of its Bash tool, so agents in a session call `sdlc`
bare. Humans and CI use `just sdlc::machines ...`, which runs this file by absolute path.
"""
import sys

sys.dont_write_bytecode = True  # keep __pycache__ out of the plugin install directory

from pathlib import Path  # noqa: E402

PLUGIN_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(PLUGIN_ROOT / "lib"))

import argparse  # noqa: E402
import math  # noqa: E402
from typing import List, Optional  # noqa: E402

import herdr  # noqa: E402
import machines  # noqa: E402

LEGEND = "! = invalid value, shown as the restrictive value it loads as; run: sdlc machines check"


def _nonempty(flag: str):
    def convert(text: str) -> str:
        if not text.strip():
            raise argparse.ArgumentTypeError("%s needs a path, got an empty value" % flag)
        return text
    return convert


_path_arg = _nonempty("--registry")
_config_arg = _nonempty("--config")


def _role_arg(text: str) -> str:
    if not machines.strip_role(text):
        raise argparse.ArgumentTypeError("a role needs a name, got %r" % text)
    return text


def _timeout_arg(text: str) -> float:
    try:
        value = float(text)
    except ValueError:
        raise argparse.ArgumentTypeError("%r is not a number" % text)
    if not math.isfinite(value) or value <= 0:
        raise argparse.ArgumentTypeError("must be a finite number of seconds > 0, got %r" % text)
    return value


def _eprint(text: str) -> None:
    print(text, file=sys.stderr)


def _inert(reg: "machines.Registry") -> None:
    print("No machine registry at %s. Machines are off, so everything runs on this box." % reg.path)
    print("To set one up: cp %s %s   (or set $%s)" % (
        PLUGIN_ROOT / "machines.example.yaml", reg.path, machines.REGISTRY_ENV))


def _plural(n: int, word: str) -> str:
    return "%d %s%s" % (n, word, "" if n == 1 else "s")


def _cell(text: str, bad: bool) -> str:
    return (text or "-") + ("!" if bad else "")


def _row(m: "machines.Machine") -> List[str]:
    inv = m.invalid
    return [
        _cell(m.name, bool(inv)),
        _cell(m.transport.describe(), any(k.split(".")[0] == "transport" for k in inv)),
        _cell(m.role or "", "role" in inv),
        _cell("yes" if m.assignable else "no", "assignable" in inv),
        _cell(",".join(m.caps), "caps" in inv),
        _cell(",".join(m.keeps), "keeps" in inv),
        _cell(m.secrets, "secrets" in inv),
    ]


def _table(reg: "machines.Registry") -> bool:
    """Print the table; return True when any '!' was printed."""
    rows = [["NAME", "TRANSPORT", "ROLE", "ASSIGNABLE", "CAPS", "KEEPS", "SECRETS"]]
    rows += [_row(m) for m in reg.machines.values()]
    widths = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
    for r in rows:
        print("  ".join(c.ljust(w) for c, w in zip(r, widths)).rstrip())
    return any(not m.ok for m in reg.machines.values())


def _counts(reg: "machines.Registry") -> str:
    return "%s, %s" % (_plural(len(reg.errors), "error"), _plural(len(reg.warnings), "warning"))


def _load(args: argparse.Namespace) -> "machines.Registry":
    return machines.load(getattr(args, "registry", None))


def cmd_list(args: argparse.Namespace) -> int:
    reg = _load(args)
    if reg.inert and not reg.errors:
        _inert(reg)
        return 0
    print("Registry: %s" % reg.path)
    if not reg.machines:
        for issue in reg.errors:
            _eprint("error    %s: %s" % (issue.where, issue.message))
        return 1
    marked = _table(reg)
    if marked:
        _eprint(LEGEND)
    if reg.errors or reg.warnings:
        _eprint("%s; run: sdlc machines check" % _counts(reg))
    return 0


def _summary(reg: "machines.Registry") -> str:
    ms = list(reg.machines.values())
    parts = []
    for n, label in (
        (sum(1 for m in ms if m.transport.kind == "local"), "local"),
        (sum(1 for m in ms if m.transport.kind == "herdr"), "herdr"),
        (sum(1 for m in ms if m.transport.kind == "none"), "without transport"),
    ):
        if n:
            parts.append("%d %s" % (n, label))
    head = _plural(len(ms), "machine")
    return "%s: %s" % (head, ", ".join(parts)) if parts else head


def _probe(reg: "machines.Registry", timeout: float) -> List["machines.Issue"]:
    out: List[machines.Issue] = []
    targets = [m for m in reg.machines.values() if m.transport.kind == "herdr"]
    if not targets:
        return out
    if not herdr.available():
        return [machines.Issue("error", "probe", "herdr not found on PATH")]
    for m in targets:
        where = "machines.%s.transport" % m.name
        try:
            agents = herdr.agent_list(m.transport.herdr, timeout=timeout)
        except herdr.HerdrError as exc:
            out.append(machines.Issue("error", where, "herdr probe failed: %s" % exc.detail))
            continue
        text = "reachable via herdr:%s, %s" % (m.transport.herdr, _plural(len(agents), "agent"))
        limit = m.limits.agents
        if limit is not None:
            text += " (limit %s)" % limit
            if len(agents) >= limit:
                text += ", full"
        out.append(machines.Issue("info", where, text))
    return out


def _placement_line(cfg: "machines.PlacementConfig") -> str:
    if cfg.path is None or (not cfg.exists and not cfg.issues):
        text = "none (no %s found)" % machines.SDLC_RELPATH
    else:
        text = str(cfg.path)
    if cfg.usable and not cfg.opted_in:
        text += " (places nothing; everything runs on this box)"
    return "Placement: " + text


def cmd_check(args: argparse.Namespace) -> int:
    reg = _load(args)
    if reg.inert and not reg.errors:
        _inert(reg)
        return 0
    print("Registry: %s" % reg.path)
    if reg.machines:
        print(_summary(reg))
    issues = list(reg.issues)
    for issue in issues:
        print("%-8s %s: %s" % (issue.level, issue.where, issue.message))
    if reg.usable:
        cfg = machines.load_placement(getattr(args, "config", None))
        print(_placement_line(cfg))
        extra = machines.placement_issues(reg, cfg)
    else:
        print("Placement: not checked (the registry is not usable)")
        extra = []
    if getattr(args, "probe", False):
        extra += _probe(reg, args.timeout)
    for issue in extra:
        print("%-8s %s: %s" % (issue.level, issue.where, issue.message))
    issues += extra
    errors = sum(1 for i in issues if i.level == "error")
    warnings = sum(1 for i in issues if i.level == "warning")
    print("check: %s (errors=%d, warnings=%d)" % ("failed" if errors else "ok", errors, warnings))
    return 1 if errors else 0


def _needs_text(needs: "machines.Needs") -> str:
    parts = []
    if needs.caps:
        parts.append("caps " + machines.shown_list(needs.caps))
    if needs.keeps:
        parts.append("keeps " + machines.shown_list(needs.keeps))
    if needs.secrets != "none":
        parts.append("secrets " + needs.secrets)
    return "; ".join(parts) or "-"


def _print_where(p: "machines.Placement", reg: "machines.Registry",
                 cfg: Optional["machines.PlacementConfig"]) -> None:
    cap = machines.cap_text

    def line(label: str, text: str) -> None:
        print(cap("  %-13s%s" % (label + ":", text)))

    if p.status == "off":
        print(cap("%s: this box (machines are off)" % p.role))
    elif p.status == "unplaceable":
        print(cap("%s: nowhere" % p.role))
    else:
        print(cap("%s: %s%s%s" % (p.role, p.machine, " (local)" if p.local else "",
                                  ", fallback" if p.status == "fallback" else "")))
    if p.status != "off":
        line("kind", p.kind or "unplaced")
        req = p.requested
        line("placement", "none (default target)" if req is None else "%s (%s)" % (req.value or "invalid", req.at))
        needs = cfg.needs.get(p.role) if cfg is not None else None
        line("needs", _needs_text(needs) if needs is not None else "-")
        if p.machine is not None:
            extra = "   (local first; sdlc delegate picks by load)" if p.target == "any" else ""
            line("candidates", machines.shown_list(p.candidates) + extra)
        for key, why in p.rejected[:machines.LIST_SHOWN]:
            line("refused", "%s: %s" % (key, why))
        if len(p.rejected) > machines.LIST_SHOWN:
            line("refused", "(+%d more)" % (len(p.rejected) - machines.LIST_SHOWN))
    line("reason", p.reason)
    line("registry", str(reg.path))
    if cfg is None:
        line("sdlc.yml", "not read (the registry is not usable)")
    else:
        line("sdlc.yml", str(cfg.path) if cfg.path is not None else "none found")


def cmd_where(args: argparse.Namespace) -> int:
    p, reg, cfg = machines.locate(args.role, args.kind, registry_file=getattr(args, "registry", None),
                                  config_file=getattr(args, "config", None), budget=None)
    _print_where(p, reg, cfg)
    if p.status == "placed":
        return 0
    if p.status == "off":
        return 0 if p.off_cause in ("no-registry", "no-placement") else 1
    return 1


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="sdlc", description="sdlc plugin command line")
    top = parser.add_subparsers(dest="command", metavar="COMMAND")
    top.required = True

    mp = top.add_parser("machines", help="show and check the machine registry")
    mp.add_argument("--registry", metavar="PATH", type=_path_arg, default=None,
                    help="registry file (default: $SDLC_MACHINES, then ${XDG_CONFIG_HOME:-~/.config}/sdlc/machines.yaml)")
    mp.add_argument("--config", metavar="FILE", type=_config_arg, default=None,
                    help="the repo's sdlc.yml (default: $CLAUDE_PROJECT_DIR, then .claude/sdlc.yml found by walking up)")
    sub = mp.add_subparsers(dest="machines_command", metavar="{list,check,where}")

    lp = sub.add_parser("list", help="print the machines")
    # SUPPRESS: a leaf default would overwrite a --registry given before the subcommand.
    lp.add_argument("--registry", metavar="PATH", type=_path_arg, default=argparse.SUPPRESS, help="registry file")
    lp.set_defaults(func=cmd_list)

    cp = sub.add_parser("check", help="validate the registry (exit 1 on any error)")
    cp.add_argument("--registry", metavar="PATH", type=_path_arg, default=argparse.SUPPRESS, help="registry file")
    cp.add_argument("--config", metavar="FILE", type=_config_arg, default=argparse.SUPPRESS, help="the repo's sdlc.yml")
    cp.add_argument("--probe", action="store_true", help="also ask herdr whether each herdr machine answers")
    cp.add_argument("--timeout", type=_timeout_arg, default=herdr.DEFAULT_TIMEOUT, metavar="SECS",
                    help="per-machine probe timeout (default: %g)" % herdr.DEFAULT_TIMEOUT)
    cp.set_defaults(func=cmd_check)

    wp = sub.add_parser("where", help="say where a phase or agent runs (exit 1 on a fallback, nowhere, or an error)")
    wp.add_argument("role", type=_role_arg, help="a phase or agent name, e.g. validator (a leading sdlc: is ignored)")
    wp.add_argument("--kind", choices=machines.KINDS, default=None,
                    help="read only the phase or only the agent placement (default: whichever names the role)")
    wp.add_argument("--registry", metavar="PATH", type=_path_arg, default=argparse.SUPPRESS, help="registry file")
    wp.add_argument("--config", metavar="FILE", type=_config_arg, default=argparse.SUPPRESS, help="the repo's sdlc.yml")
    wp.set_defaults(func=cmd_where)

    mp.set_defaults(func=cmd_list)
    return parser


def main(argv: Optional[List[str]] = None) -> int:
    args = build_parser().parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
