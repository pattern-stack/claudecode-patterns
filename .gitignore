# Environment
.env

# Logs
agent-logs/
*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Project-specific (excluded from template)
application/
trees/
.preserved-specs/
.tp/
issue-plan-*.yaml
issue-plan-*.json

# Legacy specs dirs (cross-cutting / v1) — stack-co-located specs at
# .ai-docs/stacks/<slug>/specs/<key>.md ARE tracked.
/specs/
.ai-docs/specs/

# Project-level GH project field-ID cache (per-project; should not be committed
# unless team shares the same project).
.claude/project.json

# Per-session tracker context written by the discover-tracker.sh SessionStart
# hook. Regenerated on every session start; never committed.
.claude/.session/

# Build artifacts
*.pyc
__pycache__/
node_modules/
dist/
build/

# Claude Code
.claude/settings.local.json
