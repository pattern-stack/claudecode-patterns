# claudecode-patterns v2 — environment variables
#
# Most v2 configuration lives in .claude/sdlc.yml + .claude/primitives/.
# This file holds only secrets (API keys) and integration endpoints.
#
# Copy to .env and fill in. .env is gitignored.

# === Optional: tracker integration ===
# Used by the active task-management primitive (sdlc.yml.task_management).
# Leave empty to inherit from your shell env or the global config of the
# tracker's CLI (gh / linear / tp).

# Linear (when sdlc.yml.task_management = linear)
# LINEAR_API_KEY=
# LINEAR_TEAM_ID=
# LINEAR_ORG_ID=

# GitHub Issues (when sdlc.yml.task_management = github)
# GITHUB_TOKEN=          # falls back to gh CLI auth if unset

# === Optional: dashboard endpoint for hook fan-out ===
# .claude/hooks/emit.mjs POSTs every lifecycle event here. Leave unset to
# disable telemetry.
# AP_DASHBOARD_URL=http://localhost:3456

# === All other configuration: see .claude/sdlc.yml ===
# Don't put project conventions here — put them in sdlc.yml + primitives.
