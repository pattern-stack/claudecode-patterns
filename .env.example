# Linear Integration (OPTIONAL)
# Leave empty to use global environment variables or tp CLI global config
# Set these locally to override global Linear configuration
# Get values from: https://linear.app/settings/api
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_ORG_ID=

# GitHub
GITHUB_ORG=your-org
GITHUB_REPO=your-repo
GITHUB_BASE_BRANCH=main

# Project (REQUIRED)
PROJECT_NAME=your-project
PROJECT_TEAM_KEY=BRAIN
PROJECT_STACK=fullstack

# Conventions
COMMIT_FORMAT=conventional
BRANCH_PREFIX_FEATURE=feature
BRANCH_PREFIX_BUG=fix
BRANCH_PREFIX_CHORE=chore
BRANCH_PREFIX_EPIC=feature
