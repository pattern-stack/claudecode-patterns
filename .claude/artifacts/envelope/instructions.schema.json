{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://<owner>/claude-standards/artifacts/envelope/instructions.schema.json",
  "title": "Envelope canvas instructions",
  "type": "object",
  "required": ["artifact", "version", "required_per_phase", "default_attention", "length", "emission", "surfaces", "conformance"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "artifact": { "const": "envelope" },
    "version": { "type": "integer", "minimum": 1 },

    "required_per_phase": {
      "type": "object",
      "patternProperties": {
        "^(understander|planner|specifier|implementer|validator|coordinator)$": {
          "type": "array",
          "items": { "enum": ["phase", "issue", "stack", "status", "artifact", "gate_action", "headline", "body", "attention", "next", "metadata"] },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },

    "default_attention": {
      "type": "object",
      "patternProperties": {
        "^(understander|planner|specifier|implementer|validator|coordinator)$": {
          "type": "array",
          "items": { "enum": ["chat", "tracker", "slack", "log", "pr"] },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },

    "length": {
      "type": "object",
      "properties": {
        "headline_max": { "type": "integer", "minimum": 1 },
        "body_max": { "type": "integer", "minimum": 1 },
        "next_reason_max": { "type": "integer", "minimum": 1 }
      },
      "required": ["headline_max", "body_max"],
      "additionalProperties": false
    },

    "emission": {
      "type": "object",
      "properties": {
        "always_emit": { "type": "boolean" },
        "format": { "enum": ["yaml", "json"] },
        "fence": { "type": "string" },
        "position": { "enum": ["end_of_response", "start_of_response", "separate_block"] }
      },
      "required": ["always_emit", "format", "position"],
      "additionalProperties": false
    },

    "surfaces": {
      "type": "object",
      "patternProperties": {
        "^(chat|tracker|slack|log|pr)$": {
          "type": "object",
          "properties": {
            "show": {
              "type": "array",
              "items": { "type": "string" }
            },
            "truncate_body": { "type": "integer", "minimum": 0 },
            "use_canvas": { "type": "string" },
            "format": { "enum": ["jsonl", "yaml", "markdown"] },
            "mentions_from": { "type": "string" }
          },
          "required": ["show"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "conformance": {
      "type": "object",
      "properties": {
        "reject_unset_required": { "type": "boolean" },
        "reject_token_placeholders": { "type": "boolean" },
        "reject_oversized": { "type": "boolean" }
      },
      "required": ["reject_unset_required"],
      "additionalProperties": false
    }
  }
}
