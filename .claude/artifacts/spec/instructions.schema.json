{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pattern-stack/claudecode-patterns/.claude/artifacts/spec/instructions.schema.json",
  "title": "Spec artifact instructions",
  "description": "Knobs governing how the specifier produces the spec artifact and how consumers parse it.",
  "type": "object",
  "required": ["artifact", "version", "sections"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "artifact": { "const": "spec" },
    "version": { "type": "integer", "minimum": 1 },

    "sections": {
      "type": "object",
      "required": ["order", "required", "verbosity"],
      "additionalProperties": false,
      "properties": {
        "order": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "minItems": 1
        },
        "required": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "verbosity": {
          "type": "object",
          "additionalProperties": {
            "enum": ["short", "medium", "long", "code-only", "bulleted"]
          }
        }
      }
    },

    "diagrams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": { "enum": ["mermaid", "excalidraw", "none"] },
        "in_sections": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "citations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file_paths": { "enum": ["required", "optional", "none"] },
        "line_numbers": { "type": "boolean" }
      }
    },

    "code_blocks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_language": { "type": "string" }
      }
    },

    "tracker_comment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_chars": { "type": "integer", "minimum": 100 },
        "include_sections": {
          "type": "array",
          "items": { "type": "string" }
        },
        "files_list_inline": { "type": "boolean" },
        "signature": { "type": "string" }
      }
    }
  }
}
