{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pattern-stack/claudecode-patterns/artifacts/session/instructions.schema.json",
  "title": "Session canvas instructions",
  "description": "Knobs governing how workflow commands produce session directories and how consumers parse them.",
  "type": "object",
  "required": ["artifact", "version", "session_id", "paths", "files", "artifacts_tracked", "retention", "subagent_mode", "summary_render", "enabled"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "artifact": { "const": "session" },
    "version": { "type": "integer", "minimum": 1 },

    "session_id": {
      "type": "object",
      "required": ["format", "date_format", "description_max_chars", "hash_bytes"],
      "additionalProperties": false,
      "properties": {
        "format": { "type": "string", "minLength": 1 },
        "date_format": { "type": "string", "minLength": 1 },
        "description_max_chars": { "type": "integer", "minimum": 1, "maximum": 100 },
        "description_kebab_case": { "type": "boolean" },
        "hash_bytes": { "type": "integer", "minimum": 1, "maximum": 16 }
      }
    },

    "paths": {
      "type": "object",
      "required": ["base", "parent_subdir_param"],
      "additionalProperties": false,
      "properties": {
        "base": { "type": "string", "minLength": 1 },
        "parent_subdir_param": { "type": "string", "minLength": 1 },
        "index_file": { "type": "string" }
      }
    },

    "files": {
      "type": "object",
      "required": ["session_json", "input_json", "execution_log", "summary_md"],
      "additionalProperties": false,
      "properties": {
        "session_json":   { "$ref": "#/$defs/file_spec" },
        "input_json":     { "$ref": "#/$defs/file_spec" },
        "execution_log":  { "$ref": "#/$defs/file_spec" },
        "summary_md":     { "$ref": "#/$defs/file_spec" }
      }
    },

    "artifacts_tracked": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "minItems": 1
    },

    "retention": {
      "type": "object",
      "required": ["policy"],
      "additionalProperties": false,
      "properties": {
        "policy": { "enum": ["keep_all", "keep_n", "rotate_after_days"] },
        "keep_n": { "type": "integer", "minimum": 1 },
        "days":   { "type": "integer", "minimum": 1 }
      }
    },

    "subagent_mode": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": {
        "enabled":                { "type": "boolean" },
        "subdir_naming":          { "enum": ["by_workflow_name", "by_invocation_index"] },
        "parent_records_subagent":{ "type": "boolean" },
        "output_handoff_file":    { "type": "string" }
      }
    },

    "errors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capture_phase":       { "type": "boolean" },
        "capture_message":     { "type": "boolean" },
        "capture_timestamp":   { "type": "boolean" },
        "capture_stack_trace": { "type": "boolean" }
      }
    },

    "summary_render": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include_request":            { "type": "boolean" },
        "include_artifacts":          { "type": "boolean" },
        "include_errors":             { "type": "boolean" },
        "include_follow_ups":         { "type": "boolean" },
        "include_subagent_summaries": { "type": "boolean" },
        "duration_format":            { "enum": ["human", "iso", "seconds"] }
      }
    },

    "enabled": { "type": "boolean" }
  },

  "$defs": {
    "file_spec": {
      "type": "object",
      "required": ["name", "role"],
      "additionalProperties": false,
      "properties": {
        "name":          { "type": "string", "minLength": 1 },
        "role":          { "type": "string", "minLength": 1 },
        "format":        { "enum": ["json", "jsonl", "markdown", "text"] },
        "source":        { "type": "string" },
        "update_policy": { "enum": ["immutable", "incremental", "append_only", "write_at_finalize"] }
      }
    }
  }
}
